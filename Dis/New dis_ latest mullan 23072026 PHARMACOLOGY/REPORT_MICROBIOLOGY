    new_flag = True
    view_flag = False
    mod_flag = False
ElseIf Trim(flag) = "VIEW" Then
    new_flag = False
    view_flag = True
    mod_flag = False
ElseIf Trim(flag) = "MOD" Then
    new_flag = False
    view_flag = False
    mod_flag = True
Else
    new_flag = False
    view_flag = False
    mod_flag = False
End If
End Sub

