Private Sub msk_caseno_LostFocus()
CASENO = padzero(5, "C", Msk_caseno.Text, 3)
Msk_caseno.Text = UCase(CASENO)
SELPATH_QR(0) = UCase(CASENO)
SELPATH_QR.Execute
Set SELPATH_RS = SELPATH_QR.OpenResultset(1, 3)
COMPATH.clear
If SELPATH_RS.EOF = False Then
    COMPATH.AddItem "ALL"
End If
Do Until SELPATH_RS.EOF
    If Trim(SELPATH_RS!pathno) = "" Then
    Else
    COMPATH.AddItem SELPATH_RS!pathno
    End If
    SELPATH_RS.MoveNext
Loop

COMPATH.SetFocus

End Sub

